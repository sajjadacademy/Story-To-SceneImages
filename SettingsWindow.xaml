<Window x:Class="StoryToSceneImages.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="480"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Application Settings"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Configure API keys, engines and usage preferences."
                       Foreground="#9CA3AF"
                       FontSize="12"/>
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">

                <!-- IMAGE ENGINES -->
                <GroupBox Header="Image API Settings" Margin="0,10,0,0"
                          Foreground="White" Background="#020617"
                          BorderBrush="#1F2937">
                    <StackPanel Margin="10">
                        <TextBlock Text="DeepAI API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="DeepAiKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>

                        <TextBlock Text="Leonardo AI API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="LeonardoKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>

                        <TextBlock Text="HuggingFace API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="HuggingFaceKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>
                    </StackPanel>
                </GroupBox>

                <!-- VIDEO ENGINES -->
                <GroupBox Header="Video API Settings" Margin="0,10,0,0"
                          Foreground="White" Background="#020617"
                          BorderBrush="#1F2937">
                    <StackPanel Margin="10">

                        <TextBlock Text="Pixlr Free Video API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="PixlrKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>

                        <TextBlock Text="HeyGen Paid API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="HeyGenKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>

                        <TextBlock Text="Google Veo API Key" Foreground="#9CA3AF"/>
                        <TextBox x:Name="GoogleVeoKeyBox"
                                 Margin="0,4,0,10"
                                 Background="#020617"
                                 BorderBrush="#1F2937"
                                 Foreground="White"/>

                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    Width="80"
                    Margin="4"
                    Click="Save_Click"
                    Background="#16A34A"
                    Foreground="White"/>
            <Button Content="Cancel"
                    Width="80"
                    Margin="4"
                    Click="Cancel_Click"
                    Background="#374151"
                    Foreground="White"/>
        </StackPanel>

    </Grid>
</Window>
